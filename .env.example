# ===========================================
# Call Analytics Server - Configuration
# ===========================================

# Server Configuration
PORT=3000
NODE_ENV=production
CORS_ORIGIN=*
TZ=Asia/Kolkata
LOG_LEVEL=info

# NocoDB API Configuration (Required for production)
NOCODB_API_URL=https://your-nocodb-instance.com/api/v2/tables
NOCODB_API_TOKEN=your_api_token

# NocoDB Table IDs (Required)
NOCODB_CALL_RECORDS_TABLE=your_call_records_table_id
NOCODB_DAILY_STATS_TABLE=your_daily_stats_table_id
NOCODB_IDLE_SESSIONS_TABLE=your_idle_sessions_table_id

# NocoDB View IDs (Required)
NOCODB_CALL_RECORDS_VIEW=your_call_records_view_id
NOCODB_DAILY_STATS_VIEW=your_daily_stats_view_id
NOCODB_IDLE_SESSIONS_VIEW=your_idle_sessions_view_id

# Legacy Database Configuration (Only for development with local DB)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=callanalytics
# DB_USER=admin
# DB_PASSWORD=your_secure_password_here

# Legacy Redis Configuration (Only for development)
# REDIS_HOST=localhost
# REDIS_PORT=6379